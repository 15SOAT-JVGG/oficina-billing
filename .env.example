# ARQUIVO OPCIONAL. `docker compose up` não precisa de .env: o docker-compose.yml já traz os
# defaults de desenvolvimento. Use este arquivo só para sobrescrevê-los (cp .env.example .env).

# ── PostgreSQL próprio do Billing ─────────────────────────────────────────────
# Em dev mode (./mvnw quarkus:dev) o host é localhost e a porta é a publicada pelo Compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=oficina_billing
POSTGRES_USERNAME=billing
POSTGRES_PASSWORD=billing
# `disable` para o Postgres local; `require` no RDS.
POSTGRES_SSLMODE=disable

# ── JWT (só validação) ────────────────────────────────────────────────────────
# Chave pública RS256 do par do OS Service e o issuer que ele usa. Em dev mode, copie o
# publicKey.pem do oficina-app para .local-jwt/ (ignorado pelo Git). No Compose, aponte
# JWT_PUBLIC_KEY_DIR para a pasta que contém esse arquivo.
JWT_ISSUER=oficina-api
# JWT_PUBLIC_KEY_LOCATION=.local-jwt/publicKey.pem
# JWT_PUBLIC_KEY_DIR=../oficina-app/.local-jwt

# ── Observabilidade ───────────────────────────────────────────────────────────
# OTEL_SDK_DISABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# SWAGGER_UI_ENABLED=true
